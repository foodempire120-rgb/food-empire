# Supabase Configuration (Food Empire Product CMS)
# Replace these values with your actual Supabase project URL and anon public key.
# Found in Supabase Dashboard -> Project Settings -> API.
# NEVER commit your real .env file or expose the service_role key in frontend code!

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
